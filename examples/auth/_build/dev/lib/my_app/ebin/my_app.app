{application,my_app,
             [{modules,['Elixir.Inspect.MyApp.Accounts.User','Elixir.MyApp',
                        'Elixir.MyApp.Accounts','Elixir.MyApp.Accounts.Scope',
                        'Elixir.MyApp.Accounts.User',
                        'Elixir.MyApp.Accounts.UserNotifier',
                        'Elixir.MyApp.Accounts.UserToken',
                        'Elixir.MyApp.Application','Elixir.MyApp.Blog',
                        'Elixir.MyApp.Blog.Post','Elixir.MyApp.Mailer',
                        'Elixir.MyApp.Repo','Elixir.MyAppWeb',
                        'Elixir.MyAppWeb.CoreComponents',
                        'Elixir.MyAppWeb.Endpoint',
                        'Elixir.MyAppWeb.ErrorHTML',
                        'Elixir.MyAppWeb.ErrorJSON','Elixir.MyAppWeb.Gettext',
                        'Elixir.MyAppWeb.Layouts',
                        'Elixir.MyAppWeb.PageController',
                        'Elixir.MyAppWeb.PageHTML',
                        'Elixir.MyAppWeb.PostLive.Form',
                        'Elixir.MyAppWeb.PostLive.Index',
                        'Elixir.MyAppWeb.PostLive.Show',
                        'Elixir.MyAppWeb.Router','Elixir.MyAppWeb.Telemetry',
                        'Elixir.MyAppWeb.UserAuth',
                        'Elixir.MyAppWeb.UserRegistrationController',
                        'Elixir.MyAppWeb.UserRegistrationHTML',
                        'Elixir.MyAppWeb.UserSessionController',
                        'Elixir.MyAppWeb.UserSessionHTML',
                        'Elixir.MyAppWeb.UserSettingsController',
                        'Elixir.MyAppWeb.UserSettingsHTML']},
              {compile_env,[{my_app,['Elixir.MyAppWeb.Endpoint',code_reloader],
                                    {ok,true}},
                            {my_app,['Elixir.MyAppWeb.Endpoint',debug_errors],
                                    {ok,true}},
                            {my_app,['Elixir.MyAppWeb.Endpoint',force_ssl],
                                    error},
                            {my_app,['Elixir.MyAppWeb.Gettext'],error},
                            {my_app,[dev_routes],{ok,true}}]},
              {optional_applications,[]},
              {applications,[kernel,stdlib,elixir,logger,runtime_tools,
                             bcrypt_elixir,phoenix,phoenix_ecto,ecto_sql,
                             postgrex,phoenix_html,phoenix_live_reload,
                             phoenix_live_view,phoenix_live_dashboard,esbuild,
                             tailwind,swoosh,req,telemetry_metrics,
                             telemetry_poller,gettext,jason,dns_cluster,
                             bandit]},
              {description,"my_app"},
              {registered,[]},
              {vsn,"0.1.0"},
              {mod,{'Elixir.MyApp.Application',[]}}]}.
